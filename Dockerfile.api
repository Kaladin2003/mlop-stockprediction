FROM python:3.12-slim
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY features.py .
COPY sentiment.py .
COPY main.py .
# Το μοντέλο φορτώνεται από το MLflow Model Registry
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
